# Exact versions only: `npm install <pkg>` writes "1.2.3", never "^1.2.3". The image
# installs with `npm ci` from package-lock.json, so ranges are never consulted by a
# correct build; this keeps a future add from reintroducing one. An upgrade is
# deliberate: bump the specifier, regenerate the lock, let CI test it, deploy.
save-exact=true
